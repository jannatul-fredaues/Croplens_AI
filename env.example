# CropLens API configuration
# Copy this file to `.env` and adjust values. NEVER commit `.env`.
# On Render / Cloud Run, set these as environment variables in the dashboard instead.
#
# Note: the frontend is plain HTML/JS with no build step, so it does not read
# this file. Set the API URL in frontend/js/config.js instead.

# --- App ---
APP_ENV=development            # development | production
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
PORT=8000

# --- Model ---
MODEL_PATH=../models/v1/croplens_v1.keras
LABELS_PATH=../models/v1/labels.json
CROP_INFO_PATH=./data/crop_info.json
MODEL_VERSION=v1

# Predictions below this confidence are returned as "not sure".
# Placeholder: choose the real value from validation data (Day 3).
CONFIDENCE_THRESHOLD=0.70

# --- Upload limits ---
MAX_UPLOAD_MB=5
ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/webp

# --- CORS ---
# Comma-separated list of frontend origins allowed to call the API.
# In production, set this to your Vercel URL only (no wildcard).
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# --- Optional ---
# SENTRY_DSN=
# RATE_LIMIT_PER_MINUTE=20
